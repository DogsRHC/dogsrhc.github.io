---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { site } from '../../config/site';
import { getDocuments } from '../../lib/data';
import { href } from '../../lib/format';

const documents = await getDocuments();
const { registration } = site;
---

<Base title="Inscription" description={`S'inscrire aux Dogs pour la saison ${registration.season} : adhésion en ligne, documents à fournir, séance d'essai.`}>
  <PageHead kicker={`Saison ${registration.season}`} title="S'inscrire" intro={registration.open ? "L'adhésion se fait en ligne sur HelloAsso. Voici ce qu'il te faut." : "Les inscriptions ne sont pas encore ouvertes. Elles ouvrent en général fin août."}>
    {registration.open && (
      <div class="btn-row cta">
        <a class="btn" href={registration.url} rel="noopener">Remplir l'adhésion sur HelloAsso</a>
      </div>
    )}
  </PageHead>

  <section class="section">
    <div class="wrap grid">
      <div>
        <h2>En trois étapes</h2>
        <ol class="steps">
          <li>
            <h3>Lis le règlement intérieur</h3>
            <p>L'adhésion au club vaut acceptation du règlement. <a href={href('/inscription/reglement/')}>Le règlement en ligne</a>.</p>
          </li>
          <li>
            <h3>Remplis l'adhésion sur HelloAsso</h3>
            <p>
              C'est aussi là que se règle la cotisation, qui comprend l'assurance souscrite par le club.
              {registration.open && <> <a href={registration.url} rel="noopener">Formulaire {registration.season}</a>.</>}
            </p>
          </li>
          <li>
            <h3>Fournis ton certificat ou ton questionnaire de santé</h3>
            <p>
              Première inscription : un certificat médical d'aptitude au roller hockey. Réinscription : le questionnaire QS-Sport suffit
              en général, avec l'attestation à nous transmettre. Les conditions exactes sont rappelées dans le formulaire.
            </p>
          </li>
        </ol>
      </div>

      <aside class="side">
        <h2>Bon à savoir</h2>
        <dl class="facts">
          <div><dt>Âge minimum</dt><dd>{registration.minimumAge} ans</dd></div>
          <div><dt>Niveau</dt><dd>Roller élémentaire, débutant ou confirmé en hockey</dd></div>
          <div><dt>Séance d'essai</dt><dd>Possible, sur proposition du coach</dd></div>
          <div><dt>Groupes</dt><dd>Régional ou loisir</dd></div>
        </dl>
        <p>Une question avant de te lancer ? <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </aside>
    </div>
  </section>

  <section class="section section--ice" id="documents">
    <div class="wrap">
      <p class="kicker">À télécharger</p>
      <h2>Les documents</h2>
      <ul class="docs">
        {documents.map((d) => (
          <li>
            <a href={href(`/${d.data.path}`)} download>
              <span class="docs__type" aria-hidden="true">PDF</span>
              <span class="docs__body">
                <strong>{d.data.title}</strong>
                <span>{d.data.description}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .cta {
    margin-top: 1.75rem;
  }
  .grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 3fr 2fr;
      gap: 5rem;
    }
  }
  .steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
  }
  .steps li {
    counter-increment: step;
    position: relative;
    padding: 0 0 1.5rem 4.5rem;
    min-height: 4rem;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: -0.3rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 3.6rem;
    line-height: 1;
    color: var(--accent);
  }
  .steps h3 {
    font-size: 1.5rem;
    margin-bottom: 0.3rem;
  }
  .side {
    background: var(--band);
    color: #fff;
    padding: 1.75rem;
    border-top: 6px solid var(--red);
    align-self: start;
  }
  .side h2 {
    color: #fff;
    font-size: 1.8rem;
  }
  .side a {
    color: #fff;
  }
  .facts {
    margin: 0 0 1.25rem;
  }
  .facts div {
    padding: 0.7rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }
  .facts dt {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--husky);
  }
  .facts dd {
    margin: 0.15rem 0 0;
    font-size: 1.1rem;
  }
  .docs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 800px) {
    .docs {
      grid-template-columns: 1fr 1fr;
    }
  }
  .docs a {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: var(--surface);
    padding: 1rem 1.2rem;
    text-decoration: none;
    color: var(--ink);
    border-left: 5px solid var(--rule);
    height: 100%;
  }
  .docs a:hover {
    border-left-color: var(--red);
  }
  .docs__type {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 0.95rem;
    background: var(--red);
    color: #fff;
    padding: 0.35rem 0.45rem 0.3rem;
    line-height: 1;
  }
  .docs__body {
    display: flex;
    flex-direction: column;
  }
  .docs__body strong {
    color: var(--heading);
  }
  .docs__body span {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
</style>
