---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import teamPhoto from '../assets/photos/album-062.jpg';
import { site } from '../config/site';
import { getHonours, getPartners, getRoster, getStaff } from '../lib/data';
import { href, telHref } from '../lib/format';

const staff = await getStaff();
const roster = await getRoster();
const partners = await getPartners();
const { titles } = await getHonours();

const positionLabel: Record<string, string> = {
  coach: 'Coach',
  gardien: 'Gardiens',
  défenseur: 'Défenseurs',
  attaquant: 'Attaquants',
};
---

<Base title="Le club" description={`Les Dogs, club de roller hockey de ${site.district} depuis ${site.founded} : histoire, bureau, effectif et partenaires.`}>
  <PageHead kicker={`Depuis ${site.founded}`} title="Le club" intro="Né en 1998 d'une bande de passionnés de hockey, le club a toujours gardé le même état d'esprit." />

  <section class="section">
    <div class="wrap story">
      <div class="prose">
        <h2>D'où on vient</h2>
        <p>
          Les Dogs sont nés à Meudon en {site.founded}, quand des joueurs venus du hockey sur glace et du street hockey ont décidé de
          jouer ensemble. Le club s'est structuré petit à petit, a gagné son premier titre de champion CLRH en 2015 et en compte
          aujourd'hui {titles.length}.
        </p>
        <p>
          Depuis 2025, l'équipe dispute aussi le championnat régional de la Fédération française de roller et skateboard, grâce au
          créneau en gymnase couvert que nous a ouvert la ville.
        </p>
        <h2>Ce qui compte pour nous</h2>
        <p>
          <strong>La convivialité, la simplicité et l'esprit d'équipe.</strong> On aime ce sport, tout simplement, et on prend un
          immense plaisir à le pratiquer ensemble, dans un esprit de loisir et de détente. Ça ne nous empêche pas de jouer pour gagner
          quand on est sur le terrain.
        </p>
      </div>
      <figure class="story__photo">
        <Image src={teamPhoto} alt="Photo d'équipe des Dogs en maillots marine au husky" widths={[600, 900]} sizes="(min-width: 900px) 460px, 100vw" />
        <figcaption>L'équipe en maillot marine, sur le terrain d'une rencontre CLRH.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--ice" id="bureau">
    <div class="wrap">
      <p class="kicker">L'association</p>
      <h2>Le bureau et les responsables</h2>
      <dl class="staff">
        {staff.map((s) => (
          <div class="staff__row">
            <dt>{s.data.role}</dt>
            <dd>
              <span class="staff__name">{s.data.name}</span>
              {s.data.phone && <a href={telHref(s.data.phone)}>{s.data.phone}</a>}
              {s.data.email && <a href={`mailto:${s.data.email}`}>{s.data.email}</a>}
            </dd>
          </div>
        ))}
      </dl>
      <p class="staff__note">
        Pour les joindre : <a href={`mailto:${site.email}`}>{site.email}</a>. Pour organiser un match ou un tournoi contre nous, précise-le
        dans ton message, on transmet au responsable des matchs.
      </p>
    </div>
  </section>

  <section class="section" id="effectif">
    <div class="wrap">
      <p class="kicker">Les joueurs</p>
      <h2>L'effectif</h2>
      {roster.map((group) => (
        <div class="roster">
          <h3>{positionLabel[group.position]}</h3>
          <ul>
            {group.players.map((p) => (
              <li class="jersey">
                <span class="jersey__num tabnum">{p.data.number ?? ''}</span>
                <span class="jersey__name">{p.data.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--navy" id="partenaires">
    <div class="wrap">
      <p class="kicker">Merci à eux</p>
      <h2>Nos partenaires</h2>
      <ul class="partners">
        {partners.map((p) => (
          <li>
            <a href={p.data.url} rel="noopener">{p.data.name}</a>
            <p>{p.data.description}</p>
          </li>
        ))}
      </ul>
      <p class="partners__more">
        Une entreprise du coin qui voudrait nous donner un coup de main ? <a href={href('/contact/')}>Parlons-en</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .story {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .story {
      grid-template-columns: 1fr 460px;
      gap: 4rem;
      align-items: start;
    }
  }
  .story .prose h2:first-child {
    margin-top: 0;
  }
  .story__photo {
    margin: 0;
  }
  .story__photo img {
    width: 100%;
    border-bottom: 6px solid var(--red);
  }
  figcaption {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-top: 0.6rem;
  }

  .staff {
    margin: 1.5rem 0 0;
    border-top: 3px solid var(--rule);
  }
  .staff__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.2rem 2rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .staff__row {
      grid-template-columns: 16rem 1fr;
      align-items: baseline;
    }
  }
  .staff dt {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .staff dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.25rem;
    align-items: baseline;
  }
  .staff__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.6rem;
    text-transform: uppercase;
    color: var(--heading);
  }
  .staff__note {
    margin-top: 1.5rem;
    max-width: 44em;
  }

  .roster {
    margin-top: 2rem;
  }
  .roster h3 {
    font-size: 1.3rem;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .roster ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
  }
  /* Dos de maillot : numéro en grand, prénom au-dessus */
  .jersey {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    padding: 1rem 0.5rem 1.2rem;
    background: var(--band);
    color: #fff;
    border-bottom: 6px solid var(--red);
    clip-path: polygon(18% 0, 82% 0, 100% 14%, 100% 100%, 0 100%, 0 14%);
  }
  .jersey__num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 3.4rem;
    line-height: 1;
  }
  .jersey__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--husky);
    margin-bottom: 0.2rem;
  }

  .partners {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 720px) {
    .partners {
      grid-template-columns: 1fr 1fr;
    }
  }
  .partners li {
    border-top: 3px solid var(--red);
    padding-top: 1rem;
  }
  .partners a {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2rem;
    text-transform: uppercase;
    color: #fff;
    text-decoration: none;
  }
  .partners a:hover {
    color: var(--husky);
  }
  .partners p {
    color: #dfe6f2;
    margin-top: 0.4rem;
  }
  .partners__more {
    margin-top: 2rem;
    color: #dfe6f2;
  }
  .partners__more a {
    color: #fff;
  }
</style>
