---
// Tableau des créneaux, lu depuis src/content/trainings.yaml et venues.yaml.
import { getTrainings } from '../lib/data';
import { formatTime, mapUrl } from '../lib/format';

const trainings = await getTrainings();
---

<ol class="board">
  {trainings.map((t) => (
    <li class="slot">
      <span class="slot__day">{t.day.slice(0, 3)}<span class="visually-hidden">{t.day.slice(3)}</span></span>
      <span class="slot__time tabnum">{formatTime(t.start)}<span class="slot__to"> à </span>{formatTime(t.end)}</span>
      <span class="slot__place">
        <a href={mapUrl(`${t.venue.name} ${t.venue.street ?? ''} ${t.venue.postcode} ${t.venue.city}`)}>{t.venue.name}</a>
        {t.venue.district && <span>, {t.venue.district}</span>}
        {t.group && <span class="slot__group">{t.group}</span>}
      </span>
    </li>
  ))}
</ol>

<style>
  .board {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 3px solid var(--navy);
  }
  .slot {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    grid-template-areas: 'day time' 'day place';
    column-gap: 1rem;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .slot__day {
    grid-area: day;
    align-self: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2.8rem;
    line-height: 1;
    text-transform: uppercase;
    color: var(--red);
  }
  .slot__time {
    grid-area: time;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.9rem;
    line-height: 1.1;
    color: var(--navy);
  }
  .slot__to {
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink-soft);
  }
  .slot__place {
    grid-area: place;
    color: var(--ink-soft);
  }
  .slot__place a {
    font-weight: 600;
  }
  .slot__group {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
